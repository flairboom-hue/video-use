# Local LLM (optional). Without it the chat still handles the common commands
# through a deterministic parser.
LLM_BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Cloud fallback (optional, opt-in). Nothing is sent anywhere unless you set this.
# LLM_BACKEND=openai
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=

# Speaker diarization in WhisperX needs a HuggingFace token.
# HF_TOKEN=

HOST=127.0.0.1
PORT=8000
